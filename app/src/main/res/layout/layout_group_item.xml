<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/fl_card_bg"
    app:cardCornerRadius="20dp"
    app:cardElevation="1.5dp"
    app:strokeColor="@color/fl_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="16dp">

        <!-- Left Column: Name + Expiration Pill on top, Traffic / Node count below -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/group_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/fl_text_primary"
                    android:textSize="16.5sp"
                    android:textStyle="bold"
                    tools:text="良心云" />

                <TextView
                    android:id="@+id/group_expire"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_rounded"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/theme_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="2026-11-28"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/group_traffic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/fl_text_secondary"
                android:textSize="13sp"
                tools:text="49GB / 1TB" />

        </LinearLayout>

        <!-- Right Side: Circular Indeterminate Spinner OR Relative Update Time + Check Circle -->
        <ProgressBar
            android:id="@+id/subscription_update_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="12dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/theme_primary"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/group_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:textColor="@color/fl_text_secondary"
            android:textSize="13sp"
            tools:text="13 小时前" />

        <!-- FlClash Circular Selection Check Button -->
        <FrameLayout
            android:id="@+id/group_check_circle"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_fl_check_active">

            <ImageView
                android:id="@+id/group_check_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/ic_action_done"
                app:tint="@color/white" />
        </FrameLayout>

        <!-- Subtle 3-dot menu button for quick access to Edit / Share / Delete -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/options"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:focusable="true"
            android:padding="5dp"
            app:srcCompat="@drawable/ic_baseline_more_vert_24"
            app:tint="@color/fl_text_secondary" />

        <!-- Hidden views kept for binding safety -->
        <TextView
            android:id="@+id/group_badge"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/group_active_badge"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/group_user"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/edit"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/group_traffic_progress"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/group_copy_link"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/group_update"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
