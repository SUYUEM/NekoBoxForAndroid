<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/fl_card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/fl_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:id="@+id/content_lin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp">

        <!-- Top Row: Node Name + Blue/Primary Check Badge (when selected) -->
        <LinearLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/profile_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:minLines="1"
                android:textColor="@color/fl_text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold"
                tools:text="🇭🇰 香港高速01|BGP|CMCU" />

            <!-- FlClash Circular Check Badge (Blue/Theme circle with white checkmark) -->
            <FrameLayout
                android:id="@+id/selected_view"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_marginStart="6dp"
                android:layout_marginTop="1dp"
                android:background="@drawable/bg_fl_node_checked"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/ic_action_done"
                    app:tint="@color/white" />
            </FrameLayout>

        </LinearLayout>

        <!-- Bottom Row: Protocol Type + Node Latency / Lightning Test Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/profile_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/fl_text_secondary"
                android:textSize="11.5sp"
                android:textStyle="bold"
                tools:text="Vless" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Single Node Ping / Lightning Test Action Area -->
            <LinearLayout
                android:id="@+id/layout_node_ping"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <!-- Testing Spinner -->
                <ProgressBar
                    android:id="@+id/pb_node_ping"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="3dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/theme_primary"
                    android:visibility="gone"
                    tools:visibility="gone" />

                <!-- Lightning Icon -->
                <ImageView
                    android:id="@+id/iv_node_lightning"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    app:srcCompat="@drawable/ic_fl_lightning"
                    app:tint="@color/theme_primary" />

                <!-- Latency result text -->
                <TextView
                    android:id="@+id/profile_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/fl_pill_fast_text"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="42 ms"
                    tools:visibility="visible" />

            </LinearLayout>

        </LinearLayout>

        <!-- Hidden legacy views for safe backward compatibility -->
        <TextView
            android:id="@+id/profile_address"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/traffic_text"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/edit"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/share"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/share_layer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/shareIcon"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/remove"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
