<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fl_bg_light"
    tools:openDrawer="start">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fl_bg_light"
        android:clipChildren="false">

        <!-- Main Fragment Container -->
        <FrameLayout
            android:id="@+id/fragment_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/fl_bg_light" />

        <!-- FlClash Iconic Floating Pill Bottom Navigation Bar (4 Tabs) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottom_nav_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="@color/fl_card_bg"
            app:cardCornerRadius="32dp"
            app:cardElevation="10dp"
            app:strokeColor="@color/fl_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/layout_fl_bottom_nav"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                android:paddingVertical="5dp">

                <!-- 1. 仪表盘 -->
                <LinearLayout
                    android:id="@+id/tab_dashboard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/pill_dashboard"
                        android:layout_width="54dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_fl_nav_pill_active">

                        <ImageView
                            android:id="@+id/icon_dashboard"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="仪表盘"
                            app:srcCompat="@drawable/ic_fl_dashboard"
                            app:tint="@color/theme_primary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/text_dashboard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="仪表盘"
                        android:textColor="@color/theme_primary"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 2. 代理 -->
                <LinearLayout
                    android:id="@+id/tab_configuration"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/pill_configuration"
                        android:layout_width="54dp"
                        android:layout_height="28dp">

                        <ImageView
                            android:id="@+id/icon_configuration"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="代理"
                            app:srcCompat="@drawable/ic_fl_globe"
                            app:tint="@color/fl_text_secondary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/text_configuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="代理"
                        android:textColor="@color/fl_text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- 3. 配置 -->
                <LinearLayout
                    android:id="@+id/tab_group"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/pill_group"
                        android:layout_width="54dp"
                        android:layout_height="28dp">

                        <ImageView
                            android:id="@+id/icon_group"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="配置"
                            app:srcCompat="@drawable/ic_fl_document"
                            app:tint="@color/fl_text_secondary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/text_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="配置"
                        android:textColor="@color/fl_text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- 4. 工具 -->
                <LinearLayout
                    android:id="@+id/tab_tools"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/pill_tools"
                        android:layout_width="54dp"
                        android:layout_height="28dp">

                        <ImageView
                            android:id="@+id/icon_tools"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="工具"
                            app:srcCompat="@drawable/ic_fl_toolbox"
                            app:tint="@color/fl_text_secondary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/text_tools"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="工具"
                        android:textColor="@color/fl_text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Hidden legacy BottomNavigationView for backward compatibility -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:menu="@menu/bottom_nav_menu" />

        <!-- Hidden legacy views for safe backward compatibility -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/fabProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <io.nekohasekai.sagernet.widget.ServiceButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <io.nekohasekai.sagernet.widget.StatsBar
            android:id="@+id/stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/rx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </io.nekohasekai.sagernet.widget.StatsBar>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        style="@style/Widget.Design.NavigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:itemIconTint="@color/navigation_icon"
        app:itemTextColor="@color/navigation_icon"
        app:menu="@menu/main_drawer_menu" />

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view_black"
        style="@style/Widget.Design.NavigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:visibility="gone"
        app:itemIconTint="@color/navigation_icon"
        app:itemTextColor="@color/navigation_icon"
        app:menu="@menu/main_drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
